# Copy to .env.local. Never commit keys or put them in browser JavaScript.
# Select one provider. The development server uses Tinker when selected.
AI_PROVIDER=tinker
TINKER_API_KEY=paste_your_api_key_here
TINKER_MODEL_PATH=tinker://your-full-sampler-checkpoint-path

# To use Gemini instead, set AI_PROVIDER=gemini and fill these values.
GEMINI_API_KEY=paste_your_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
